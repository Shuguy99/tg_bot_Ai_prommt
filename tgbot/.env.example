# ============================================================================
#  Server-side secrets — Pages Functions / Workers environment.
#  NEVER prefix these with VITE_: anything VITE_ is inlined into the JS bundle
#  and is readable by anyone who opens devtools.
# ============================================================================

# Supabase (service role bypasses RLS — treat as full DB admin)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot
TELEGRAM_BOT_TOKEN=
# Shared secret for the Bot API webhook (setWebhook ?secret_token=...). Optional
# but recommended: without it anyone who finds the URL can post fake updates.
TELEGRAM_WEBHOOK_SECRET=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Sends payments through the YooKassa sandbox. Use while developing.
YOOKASSA_TEST_MODE=false
# Adds a `receipt` object to every payment. Required if you are ИП/ООО and owe
# the buyer a cheque under 54-FZ. Set only once the tax regime is decided.
YOOKASSA_REQUIRE_RECEIPT=false
# Leave unset unless "signature for webhooks" is enabled in the shop settings —
# YooKassa does not send an HMAC by default. See README.
YOOKASSA_WEBHOOK_SECRET=
# Overrides YooKassa's published notification source ranges.
# YOOKASSA_WEBHOOK_ALLOWED_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32

# Public HTTPS origin of this deployment. Used to build YooKassa return_url.
APP_BASE_URL=https://your-tma.example.com

# Comma-separated browser origins allowed to call the API. Only needed for local
# dev tunnels; same-origin on Pages needs nothing.
ALLOWED_ORIGINS=http://localhost:5173

# ============================================================================
#  Client-visible vars — safe to expose, but keep them free of secrets.
# ============================================================================

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key is public by design. RLS is what protects the data.
VITE_SUPABASE_ANON_KEY=
# Leave empty to call /api/* on the same origin (correct for Cloudflare Pages).
VITE_API_BASE_URL=